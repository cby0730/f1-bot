# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Required: get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Telegram client network settings for local environments that require proxy/custom timeouts
# TELEGRAM_PROXY=socks5://127.0.0.1:7890
# TELEGRAM_CONNECT_TIMEOUT=20.0
# TELEGRAM_READ_TIMEOUT=20.0

# PostgreSQL connection URL — docker-compose sets this automatically via environment.
# For local dev with docker-compose.dev.yml:
# F1BOT_DATABASE_URL=postgresql://mango:mango@localhost:31050/mango

# PostgreSQL password (used by docker-compose.yml for the postgres service)
# POSTGRES_PASSWORD=your_secure_password_here

# Log level: DEBUG, INFO, WARNING, ERROR
F1BOT_LOG_LEVEL=INFO

# Log format: auto (console if TTY, JSON if not), console (forced pretty/colored), json
F1BOT_LOG_FORMAT=auto
