# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Required: get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Redis — when using docker-compose, REDIS_URL is set automatically.
# Override only when running the bot outside of docker-compose.
REDIS_URL=redis://localhost:6379/0

# SQLite database path — docker-compose sets this to /data/f1bot.db via volume.
F1BOT_SQLITE_PATH=f1bot.db

# Log level: DEBUG, INFO, WARNING, ERROR
F1BOT_LOG_LEVEL=INFO

# Log format: auto (console if TTY, JSON if not), console (forced pretty/colored), json
F1BOT_LOG_FORMAT=auto
